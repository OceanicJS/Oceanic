{
  "name": "oceanic.js",
  "version": "1.14.0",
  "description": "A NodeJS library for interfacing with Discord.",
  "packageManager": "pnpm@10.23.0",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "module": "./esm.mjs",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "bun": "./dist/lib/index.js",
      "require": "./dist/lib/index.js",
      "import": "./esm.mjs"
    }
  },
  "scripts": {
    "lint": "eslint lib",
    "lint:fix": "eslint lib --fix",
    "prepare": "rimraf dist && tsc -p tsconfig.json && cp -r lib/types dist/lib/types",
    "test:build": "pnpm run prepare",
    "test:esm": "node --no-warnings --no-deprecation esm.mjs",
    "test:docs": "rimraf docs && pnpm dlx typedoc --options static/typedoc.json",
    "test": "pnpm run lint && pnpm run test:build && pnpm run test:esm && pnpm run test:docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OceanicJS/Oceanic.git"
  },
  "keywords": [
    "discord",
    "library",
    "discord-api",
    "api"
  ],
  "author": "Donovan Daniels <hewwo@yiff.rocks>",
  "contributors": [
    "Nuckyz (https://github.com/Nuckyz)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OceanicJS/Oceanic/issues"
  },
  "homepage": "https://github.com/OceanicJS/Oceanic#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@favware/npm-deprecate": "^2.0.0",
    "@mxssfd/typedoc-theme": "^1.1.7",
    "@types/node": "~25.3.5",
    "@types/pako": "^2.0.4",
    "@types/ws": "^8.18.1",
    "erlpack": "^0.1.4",
    "eslint": "^10.0.3",
    "eslint-plugin-jsdoc": "^62.7.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "pako": "^2.1.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.17",
    "typedoc-plugin-extras": "~4.0.1",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-merge-modules": "7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "undici-types": "~7.18.2",
    "zlib-sync": "^0.1.10",
    "zstd-napi": "^0.0.12"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "ws": "^8.19.0"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "optionalDependencies": {
    "@discordjs/voice": "^0.19.0"
  }
}
